# ── 이 파일을 복사해서 .env 로 만들고, 값을 채우세요 ──
#   cp .env.example .env
# .env 는 깃에 올라가지 않습니다(.gitignore).

# AI 글쓰기 제공자: gemini | claude | none
#  - gemini : 무료로 시작 (권장)
#  - claude : 나중에 투자 시
#  - none   : 키 없이 골격만 (경쟁분석·구조·점수·플랜)
LLM_PROVIDER=gemini

# ── Gemini (무료) ── https://aistudio.google.com 에서 발급
GEMINI_API_KEY=
# 무료 티어는 Flash 계열만 가능(Pro는 유료/크레딧 필요). 에러 시 gemini-2.0-flash / gemini-1.5-flash 시도
GEMINI_MODEL=gemini-2.5-flash
# (선택) 유료·크레딧으로 품질을 높이려면: GEMINI_MODEL=gemini-2.5-pro

# ═══════════════════════════════════════════════════════════
# ★ Vertex AI (Google Cloud 크레딧 계정용) ★
#   AI Studio 키가 'AQ.'로 나와서 막힌다면 이걸 쓰세요. 크레딧 그대로 사용.
#   위 LLM_PROVIDER 를 vertex 로, 아래 IMAGE_PROVIDER 도 vertex 로 바꾸세요.
#     LLM_PROVIDER=vertex
#     IMAGE_PROVIDER=vertex
#     GEMINI_MODEL=gemini-2.5-pro
#     GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
# ───────────────────────────────────────────────────────────
GEMINI_VERTEX_PROJECT=          # 프로젝트 ID (예: gen-lang-client-0937284289)
GEMINI_VERTEX_LOCATION=global   # global (또는 us-central1)
# 서비스 계정 JSON 파일 경로 (seo-writer 폴더에 두면 파일명만)
GOOGLE_APPLICATION_CREDENTIALS=gcloud-key.json
# ═══════════════════════════════════════════════════════════

# ── 이미지 생성 (위 GEMINI_API_KEY 또는 Vertex 재사용) ──
#  none = 안 만듦 / gemini = API 키 / vertex = 크레딧 계정
IMAGE_PROVIDER=gemini
# 상세페이지에서 쓰던 모델로 맞추세요. 예) imagen-4.0-generate-001, imagen-3.0-generate-002, gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_ASPECT=16:9      # 블로그 가로형 (1:1, 4:3, 3:2 등 가능)
IMAGE_COUNT=3          # 대표 1 + 본문 2 (최대 6)

# ── Claude (나중에) ── https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── 구글 경쟁 분석 (선택) ── https://serper.dev 무료 크레딧
#  비워두면 'allintitle 링크를 직접 눌러 확인'하는 수동 모드로 동작(영구 무료)
SERPER_API_KEY=
