# ── 이 파일을 복사해서 .env 로 만들고, 값을 채우세요 ──
#   cp .env.example .env
# .env 는 깃에 올라가지 않습니다(.gitignore).

# AI 글쓰기 제공자: gemini | claude | none
#  - gemini : 무료로 시작 (권장)
#  - claude : 나중에 투자 시
#  - none   : 키 없이 골격만 (경쟁분석·구조·점수·플랜)
LLM_PROVIDER=gemini

# ── Gemini (무료) ── https://aistudio.google.com 에서 발급
GEMINI_API_KEY=
# 무료 티어는 Flash 계열만 가능(Pro는 유료/크레딧 필요). 에러 시 gemini-2.0-flash / gemini-1.5-flash 시도
GEMINI_MODEL=gemini-2.5-flash
# (선택) 유료·크레딧으로 품질을 높이려면: GEMINI_MODEL=gemini-2.5-pro

# ── 이미지 생성 (Gemini, 위 GEMINI_API_KEY 재사용) ──
#  none = 이미지 안 만듦 / gemini = 생성
IMAGE_PROVIDER=gemini
# 상세페이지에서 쓰던 모델로 맞추세요. 예) imagen-4.0-generate-001, imagen-3.0-generate-002, gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_ASPECT=16:9      # 블로그 가로형 (1:1, 4:3, 3:2 등 가능)
IMAGE_COUNT=3          # 대표 1 + 본문 2 (최대 6)

# ── Claude (나중에) ── https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── 구글 경쟁 분석 (선택) ── https://serper.dev 무료 크레딧
#  비워두면 'allintitle 링크를 직접 눌러 확인'하는 수동 모드로 동작(영구 무료)
SERPER_API_KEY=
