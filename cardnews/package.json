{
  "name": "cardnews-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "인스타그램 카드뉴스 자동 생성기 — 주제·제목 입력 → LLM 카피 → 1080×1350 캐러셀 카드 자동 완성",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "dev:web": "vite",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.56.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
