# 서버 전용 — 프론트엔드 번들에 절대 포함되지 않습니다.
ANTHROPIC_API_KEY=sk-ant-...
# 선택: 카피 생성에 쓸 모델 (기본 claude-sonnet-4-5)
# CARDNEWS_MODEL=claude-sonnet-4-5
# 선택: 서버 포트 (기본 8787)
# PORT=8787

# ── 가게 검색 (선택) ── 상호·주소·카테고리·전화·좌표만. 별점·리뷰는 안 가져옴.
# 하나만 넣어도 되고 둘 다 넣으면 UI에서 제공자를 고를 수 있습니다.
# 카카오 로컬 REST 키 (developers.kakao.com)
# KAKAO_REST_KEY=
# 네이버 검색(지역) 키 (developers.naver.com)
# NAVER_SEARCH_ID=
# NAVER_SEARCH_SECRET=

# ── 정적 지도 배경 (선택) ── 가게 위치를 카드 배경으로. 네이버 클라우드 Maps.
# 미설정 시 '지도' 배경은 가게명 주제 사진으로 자동 폴백됩니다.
# NCP_MAP_KEY_ID=
# NCP_MAP_KEY=

# 주제 사진(Openverse CC0)은 키가 필요 없습니다. 사용자가 UI에서 Unsplash 키를
# 넣으면 그 카드부터 실사진(Unsplash)으로 자동 교체됩니다.
